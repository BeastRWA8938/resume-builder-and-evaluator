# Google Gemini API Key - Required for resume analysis
# Retrieve yours from: https://aistudio.google.com/
GEMINI_API_KEY=

# SQLite database file path (optional - defaults to backend/resume_analyzer.db)
# DATABASE_PATH=

# Gemini Model Name (optional - defaults to gemini-2.5-flash)
# GEMINI_MODEL_NAME=gemini-2.5-flash

# Path to store compiled resumes on host device (optional - defaults to ./Resumes)
# RESUME_OUTPUT_PATH=c:/Users/YourUsername/Documents/Resume


